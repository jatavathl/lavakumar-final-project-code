        "def generate_explainable_risk_report(\n",
        "    patient_index,\n",
        "    top_n=5\n",
        "):\n",
        "    \"\"\"\n",
        "    Combine model prediction, risk category and\n",
        "    strongest SHAP contributions for one patient.\n",
        "    \"\"\"\n",
        "\n",
        "    patient_data = X_test.iloc[[patient_index]]\n",
        "\n",
        "    probability = float(\n",
        "        final_model.predict_proba(\n",
        "            patient_data\n",
        "        )[0, 1]\n",
        "    )\n",
        "\n",
        "    predicted_class = int(\n",
        "        final_model.predict(\n",
        "            patient_data\n",
        "        )[0]\n",
        "    )\n",
        "\n",
        "    actual_class = int(\n",
        "        y_test.iloc[patient_index]\n",
        "    )\n",
        "\n",
        "    risk_category = assign_risk_category(\n",
        "        probability\n",
        "    )\n",
        "\n",
        "    contribution_df = pd.DataFrame({\n",
        "        \"Feature\": clean_feature_names,\n",
        "        \"Feature Value\": X_test_shap[\n",
        "            patient_index\n",
        "        ],\n",
        "        \"SHAP Contribution\": shap_values.values[\n",
        "            patient_index\n",
        "        ]\n",
        "    })\n",
        "\n",
        "    contribution_df[\"Absolute Contribution\"] = (\n",
        "        contribution_df[\"SHAP Contribution\"].abs()\n",
        "    )\n",
        "\n",
        "    contribution_df[\"Effect\"] = np.where(\n",
        "        contribution_df[\"SHAP Contribution\"] > 0,\n",
        "        \"Increases predicted risk\",\n",
        "        \"Decreases predicted risk\"\n",
        "    )\n",
        "\n",
        "    contribution_df = (\n",
        "        contribution_df\n",
        "        .sort_values(\n",
        "            \"Absolute Contribution\",\n",
        "            ascending=False\n",
        "        )\n",
        "        .head(top_n)\n",
        "        .reset_index(drop=True)\n",
        "    )\n",
        "\n",
        "    summary_df = pd.DataFrame({\n",
        "        \"Patient Index\": [patient_index],\n",
        "        \"Actual Outcome\": [actual_class],\n",
        "        \"Predicted Outcome\": [predicted_class],\n",
        "        \"Disease Probability\": [probability],\n",
        "        \"Risk Percentage\": [probability * 100],\n",
        "        \"Risk Category\": [risk_category]\n",
        "    })\n",
        "\n",
        "    print(\"PATIENT RISK SUMMARY\")\n",
        "    display(summary_df.round(4))\n",
        "\n",
        "    print(\"\\nSTRONGEST MODEL EXPLANATIONS\")\n",
        "    display(contribution_df.round(4))\n",
        "\n",
        "    return summary_df, contribution_df"
