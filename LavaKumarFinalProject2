        "def lime_explanation_to_dataframe(\n",
        "    lime_explanation,\n",
        "    class_label=1\n",
        "):\n",
        "    \"\"\"\n",
        "    Convert a LIME explanation into a DataFrame.\n",
        "    \"\"\"\n",
        "\n",
        "    lime_rows = lime_explanation.as_list(\n",
        "        label=class_label\n",
        "    )\n",
        "\n",
        "    lime_df = pd.DataFrame(\n",
        "        lime_rows,\n",
        "        columns=[\n",
        "            \"Feature Condition\",\n",
        "            \"LIME Contribution\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "    lime_df[\"Direction\"] = np.where(\n",
        "        lime_df[\"LIME Contribution\"] > 0,\n",
        "        \"Increases predicted risk\",\n",
        "        \"Decreases predicted risk\"\n",
        "    )\n",
        "\n",
        "    return lime_df"
