        "\n",
        "    patient_shap_df = pd.DataFrame({\n",
        "        \"Feature\": clean_feature_names,\n",
        "        \"Feature Value\": X_test_shap[\n",
        "            patient_index\n",
        "        ],\n",
        "        \"SHAP Contribution\": shap_values.values[\n",
        "            patient_index\n",
        "        ]\n",
        "    })\n",
        "\n",
        "    patient_shap_df[\"Absolute Contribution\"] = (\n",
        "        patient_shap_df[\n",
        "            \"SHAP Contribution\"\n",
        "        ].abs()\n",
        "    )\n",
        "\n",
        "    patient_shap_df[\"Direction\"] = np.where(\n",
        "        patient_shap_df[\n",
        "            \"SHAP Contribution\"\n",
        "        ] > 0,\n",
        "        \"Increases predicted risk\",\n",
        "        \"Decreases predicted risk\"\n",
        "    )\n",
        "\n",
        "    return (\n",
        "        patient_shap_df\n",
        "        .sort_values(\n",
        "            \"Absolute Contribution\",\n",
        "            ascending=False\n",
        "        )\n",
        "        .head(top_n)\n",
        "        .reset_index(drop=True)\n",
        "    )"
